{
  "datasetVersion": "1.0",
  "project": "simple-auth-service",
  "description": "Synthetic register/login/refresh-oriented test vectors for API validation, normalization, and security regressions. Passwords are fictional placeholders for automated tests only.",
  "datasetDocumentation": {
    "diversityStrategy": [
      "Email local parts vary by pattern: given.family, initials, numeric suffixes, plus-addressing, department-style prefixes, and non-ASCII UTF-8 segments where valid for the validator.",
      "Domains span consumer mail (gmail, outlook, yahoo), regional TLDs (.de, .co.uk, .jp corporate-style), newer TLDs (.io, .dev), and subdomain-heavy hosts to exercise parsing beyond a single token.",
      "Passwords mix lengths (minimum legal 6 through moderately long), character classes (alphanumerics, symbols, spaces), and unicode letters to catch length/count bugs that assume ASCII.",
      "Intent labels split across register vs login vs negative-validation scenarios so the same file supports happy-path and failure-path suites."
    ],
    "biasMitigation": [
      "No demographic labels or geographic stereotypes tied to expected outcomes; names and domains are synthetic blends, not proxies for real populations.",
      "Avoided over-representing a single domain or provider; counts are roughly balanced across several domain categories.",
      "Included internationalized and punctuation-heavy emails alongside ASCII to reduce Western-only coverage bias.",
      "Edge vectors mimic attack patterns and malformed transport (OWASP-style strings, prototype pollution keys, extreme lengths) without implying any group is more likely to submit them — they are universal abuse cases."
    ],
    "categories": {
      "normal": "Inputs expected to pass route validation for register (email valid, password length >= 6) or login (email valid, password non-empty) under typical service behavior.",
      "boundary": "Valid but extreme or fragile: minimum-length passwords, long emails, heavy punctuation, whitespace-only passwords that still satisfy length rules, plus-tags, etc.",
      "edge": "Malformed, ambiguous, or attacker-shaped payloads that often expose bugs in naive trimming, duplicate detection, typing, or resource limits — expect 400/401/409 depending on endpoint."
    }
  },
